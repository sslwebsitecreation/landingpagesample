{{!-- template-lint-disable no-inline-styles style-concatenation --}}
<section class="shop-by-category" {{scroll-reveal delay=100}}>
  <div class="category-container">
    <div class="category-header">
      <div class="header-left">
        <span class="section-eyebrow">Curated Collections</span>
        <h2 class="section-title">Shop by <span>Category</span></h2>
        <p class="section-subtitle">Explore our handpicked categories, each showcasing the beauty of traditional weaving passed down through generations.</p>
        <div class="title-underline"></div>
      </div>
      <div class="header-right">
        <button type="button" class="view-all-link" {{on "click" @onViewAll}}>
          View All Categories
          <span class="arrow">→</span>
        </button>
      </div>
    </div>

    <div class="carousel-wrapper">
      {{#if this.showArrows}}
        <button type="button" class="carousel-arrow carousel-arrow--prev" {{on "click" this.scrollPrev}} aria-label="Previous categories">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
      {{/if}}
      <div
        class="carousel-track"
        {{did-insert this.setupCarousel}}
        {{on "scroll" this.handleInteraction}}
        {{on "mouseenter" this.handleInteraction}}
        {{on "touchstart" this.handleInteraction}}
      >
        {{#each this.currentStore.categories as |cat index|}}
          <LinkTo
            @route="collections"
            @query={{hash category=cat.name page=1}}
            class="category-card"
            style="--item-index: {{index}}"
          >
            <div class="card-orb">
              <div class="orb-inner">
                <img src={{cat.image}} alt={{cat.name}} loading="lazy" width="110" height="110">
              </div>
              <div class="orb-shadow"></div>
            </div>
            <span class="category-name">{{cat.name}}</span>
            <span class="category-desc">{{category-count cat this.currentStore.products}} pieces</span>
          </LinkTo>
        {{/each}}
      </div>
      {{#if this.showArrows}}
        <button type="button" class="carousel-arrow carousel-arrow--next" {{on "click" this.scrollNext}} aria-label="Next categories">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      {{/if}}
    </div>
  </div>
</section>
