<section class="collection-section" {{scroll-reveal delay=150}}>
  <div class="section-header-wrapper">
    <span class="section-eyebrow">Trending Now</span>
    <h2 class="section-title">Explore Our <span>Collection</span></h2>
    <p class="section-subtitle">Discover the most loved sarees, handpicked for quality and style.</p>
  </div>

  <div class="tabs-container">
    {{!-- Sliding Tab Header --}}
    <div class="tab-switcher">
      <div class="tab-glide-pill is-{{this.activeTab}}"></div>

      <button
        type="button"
        class="tab-btn {{if (equal this.activeTab 'Trending') 'is-active'}}"
        {{on "click" (fn this.setTab 'Trending')}}
      >
        Trending Sarees
      </button>

      <button
        type="button"
        class="tab-btn {{if (equal this.activeTab 'Special') 'is-active'}}"
        {{on "click" (fn this.setTab 'Special')}}
      >
        Store Specials
      </button>
    </div>
  </div>

  {{!-- Product Grid with Animation Key --}}
  <div class="collection-grid-wrapper" key={{this.activeTab}}>
    <div class="product-grid-container">
      {{#each this.activeCollection as |product|}}
        <ProductCard @product={{product}} />
      {{else}}
        <div class="tabs-empty">
          <div class="tabs-empty-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3 class="tabs-empty-title">
            {{if (equal this.activeTab 'Trending') 'No Trending Sarees' 'No Specials Available'}}
          </h3>
          <p class="tabs-empty-sub">
            {{if (equal this.activeTab 'Trending') 'Trending sarees will appear here as they gain popularity.' 'Store specials are being curated. Check back soon!'}}
          </p>
        </div>
      {{/each}}
    </div>
  </div>

  <div class="collection-footer">
    <LinkTo @route="collections" class="view-all-link">
      View Entire Collection <span>→</span>
    </LinkTo>
  </div>
</section>
