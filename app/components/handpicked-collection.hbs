<section class="hp-section" {{scroll-reveal delay=100}}>
  <div class="hp-container">

    {{!-- HEADER --}}
    <div class="hp-header">
      <span class="hp-eyebrow">EXCLUSIVELY FOR YOU</span>
      <h2 class="hp-title">Client's Handpicked <span>Sarees</span></h2>
      <p class="hp-subtitle">Curated with love, chosen by our clients.</p>
    </div>

    {{!-- MOBILE STICKY PREVIEW --}}
    <div class="hp-mobile-sticky">
      {{#if this.activeSaree}}
        <div class="hp-mobile-card">
          <div class="hp-mobile-card-inner">
            <div class="hp-mobile-image-wrap" {{on "click" this.openPreview}} role="button" tabindex="0">
              <img
                src={{this.activePreviewVariant.image}}
                alt={{this.activeSaree.name}}
                class="hp-mobile-image {{if this.isTransitioning 'is-fading'}}"
                loading="lazy"
                width="200" height="260"
              >
              <div class="hp-expand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              </div>
            </div>
            <div class="hp-mobile-body">
              <h4 class="hp-mobile-title {{if this.isTransitioning 'is-fading'}}">{{this.activeSaree.name}}</h4>
              <div class="hp-mobile-price-row">
                <div>
                  <span class="hp-mobile-price">₹{{this.activeSaree.price}}</span>
                  <span class="hp-mobile-old-price">₹{{this.activeSaree.oldPrice}}</span>
                </div>
                {{#if this.activeSaree.oldPrice}}
                  <span class="hp-off-badge">{{this.activeSaree.discount}}% OFF</span>
                {{/if}}
              </div>
              <p class="hp-mobile-desc {{if this.isTransitioning 'is-fading'}}">{{this.activeSaree.description}}</p>
              {{#if (gt this.activeSaree.variants.length 1)}}
                <div class="hp-mobile-variant-strip {{if this.isTransitioning 'is-fading'}}">
                  {{#each this.activeSaree.variants as |variant vi|}}
                    <button
                      type="button"
                      class="hp-variant-swatch {{if (equal this.activeVariantIndex vi) 'is-active'}}"
                      {{on "click" (fn this.selectVariant vi)}}
                      aria-label={{variant.name}}
                    >
                      <span class="hp-variant-dot" style="background-color: {{variant.hex}}"></span>
                    </button>
                  {{/each}}
                </div>
              {{/if}}
              <LinkTo @route="product" @model={{this.activeSaree.id}} @query={{hash color=this.activeColorHex}} class="hp-mobile-cta">
                View Details
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </LinkTo>
            </div>
          </div>
        </div>
      {{/if}}
    </div>

    {{!-- DESKTOP LAYOUT --}}
    <div class="hp-desktop-layout">

      {{!-- LEFT: Selector Panel --}}
      <div class="hp-selector">
        <div class="hp-selector-list">
          {{#each this.sarees as |saree index|}}
            <button
              type="button"
              class="hp-selector-item {{if (equal this.activeIndex index) 'is-active'}}"
              {{on "click" (fn this.selectSaree index)}}
            >
              <div class="hp-item-thumb">
                <img src={{saree.variants.[0].image}} alt={{saree.name}} loading="lazy" width="60" height="80">
              </div>
              <div class="hp-item-info">
                <span class="hp-item-name">{{saree.name}}</span>
              </div>
              <div class="hp-item-badge">{{add index 1}}</div>
            </button>
          {{/each}}
        </div>
        <div class="hp-selector-footer">
          <span class="hp-count-badge">{{this.sarees.length}} Handpicked Favorites</span>
        </div>
      </div>

      {{!-- RIGHT: Preview Panel --}}
      <div class="hp-preview">
        {{#if this.activeSaree}}
          <div class="hp-preview-card">
            <div class="hp-preview-image-wrap" {{on "click" this.openPreview}} role="button" tabindex="0">
              <img
                src={{this.activePreviewVariant.image}}
                alt={{this.activeSaree.name}}
                class="hp-preview-image {{if this.isTransitioning 'is-fading'}}"
                loading="lazy"
                width="400" height="533"
              >
              <div class="hp-expand-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              </div>
              <div class="hp-preview-badge">Bestseller</div>
            </div>
            <div class="hp-preview-body">
              <h3 class="hp-preview-title {{if this.isTransitioning 'is-fading'}}">{{this.activeSaree.name}}</h3>
              <div class="hp-price-section {{if this.isTransitioning 'is-fading'}}">
                <span class="hp-price">₹{{this.activeSaree.price}}</span>
                {{#if this.activeSaree.oldPrice}}
                  <span class="hp-old-price">₹{{this.activeSaree.oldPrice}}</span>
                  <span class="hp-off-badge">{{this.activeSaree.discount}}% OFF</span>
                {{/if}}
              </div>
              <div class="hp-meta-grid {{if this.isTransitioning 'is-fading'}}">
                <div class="hp-meta-row">
                  <span class="hp-meta-label">Category</span>
                  <span class="hp-meta-value">{{this.activeSaree.category}}</span>
                </div>
              </div>
              <div class="hp-meta-row">
                <div class="hp-meta-label">Description</div>
                <p class="hp-preview-desc {{if this.isTransitioning 'is-fading'}}">{{this.activeSaree.description}}</p>
              </div>
              {{#if (gt this.activeSaree.variants.length 1)}}
                <div class="hp-meta-row">
                  <div class="hp-meta-label">Available Colors</div>
                  <div class="hp-variant-strip {{if this.isTransitioning 'is-fading'}}">
                    {{#each this.activeSaree.variants as |variant vi|}}
                      <button
                        type="button"
                        class="hp-variant-swatch {{if (equal this.activeVariantIndex vi) 'is-active'}}"
                        {{on "click" (fn this.selectVariant vi)}}
                        aria-label={{variant.name}}
                      >
                        <span class="hp-variant-dot" style="background-color: {{variant.hex}}"></span>
                      </button>
                    {{/each}}
                  </div>
                </div>
              {{/if}}
              <div class="hp-preview-footer">
                <LinkTo @route="product" @model={{this.activeSaree.id}} @query={{hash color=this.activeColorHex}} class="hp-cta-btn">
                  View Details
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </LinkTo>
              </div>
            </div>
          </div>
        {{/if}}
      </div>
    </div>

  </div>
</section>

{{!-- Full-screen image preview --}}
{{#if this.showPreview}}
  <div class="hp-preview-overlay" {{on "click" this.closePreview}} role="presentation">
    <button type="button" class="hp-preview-close" {{on "click" this.closePreview}} aria-label="Close preview">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="hp-preview-content" {{on "click" this.stopPropagation}} role="presentation">
      <img src={{this.activeSaree.variants.[0].image}} alt={{this.activeSaree.name}} class="hp-preview-full-img" />
    </div>
  </div>
{{/if}}
