{{#if @visible}}
  <div
    class="search-filter-overlay"
    {{on "click" @onClose}}
    {{act-as-a-button}}
  >
    <div
      class="search-filter-modal {{if @position (concat "search-filter-modal--" @position)}}"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sfm-title"
      {{on "click" this.stopPropagation}}
    >
      <div class="sfm-header">
        <h3 id="sfm-title" class="sfm-title">
          Search & Filter
        </h3>

        <button
          type="button"
          class="sfm-close"
          {{on "click" @onClose}}
          aria-label="Close filter"
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="sfm-body">

        {{!-- Main Search --}}
        <div class="sfm-field sfm-field--search">
          <label class="sfm-label" for="sfm-search-input">Search</label>

          <div class="sfm-search-wrapper">
            <svg
              class="sfm-search-icon"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>

            <input
              id="sfm-search-input"
              type="text"
              class="sfm-input sfm-input--search"
              placeholder="Search sarees, fabrics, styles..."
              value={{this.localQuery}}
              {{on "input" this.handleSearchInput}}
              {{on "keyup" this.handleSearchKeyDown}}
            />

            {{#if this.localQuery}}
              <button
                type="button"
                class="sfm-input-clear"
                {{on "click" this.clearLocalSearch}}
                aria-label="Clear search"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            {{/if}}
          </div>
        </div>

        {{!-- Category --}}
        <div class="sfm-field">
          <label class="sfm-label" for="category-input">
            Category
          </label>

          <div class="sfm-autocomplete">
            <input
              id="category-input"
              type="text"
              class="sfm-input"
              placeholder="Select category..."
              value={{this.categoryQuery}}
              {{on "input" this.handleCategoryInput}}
              {{on "focus" this.handleCategoryFocus}}
              {{on "blur" this.handleCategoryBlur}}
              autocomplete="off"
            />

            {{#if this.categoryQuery}}
              <button
                type="button"
                class="sfm-input-clear"
                {{on "mousedown" this.clearCategory}}
                aria-label="Clear category"
              >
                <svg
                  viewBox="0 0 24 24"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            {{/if}}

            {{#if this.categoryInputFocused}}
              <div class="sfm-dropdown" role="listbox">

                {{#if this.search.selectedCategory}}
                  <button
                    type="button"
                    class="sfm-dropdown-item sfm-clear"
                    {{on "mousedown" this.clearCategory}}
                    role="option"
                  >
                    Clear selection
                  </button>
                {{/if}}

                {{#each this.filteredCategories as |category|}}
                  <button
                    type="button"
                    role="option"
                    class="sfm-dropdown-item {{if (equal category.category_id this.search.selectedCategory.category_id) "sfm-selected"}}"
                    {{on "mousedown" (fn this.selectCategory category)}}
                  >
                    {{category.name}}
                  </button>
                {{/each}}

              </div>
            {{/if}}
          </div>
        </div>

        {{!-- Tags --}}
        <div class="sfm-field sfm-field--tags">
          <label class="sfm-label">
            Tags
          </label>

          <div class="sfm-tags-dropdown">
            <button
              type="button"
              class="sfm-tags-chip {{if this.appliedTags.length "sfm-tags-chip--active"}}"
              {{on "click" this.toggleTagsPanel}}
              aria-expanded="{{if this.isTagsOpen "true" "false"}}"
            >
              <span class="sfm-tags-chip-label">
                {{if this.appliedTags.length (concat this.appliedTags.length " selected") "Select tags"}}
              </span>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="sfm-tags-chevron {{if this.isTagsOpen "sfm-tags-chevron--open"}}">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            {{#if this.isTagsOpen}}
              <div class="sfm-tags-panel">
                <div class="sfm-tags-options">
                  {{#each this.search.tags as |tag|}}
                    <button
                      type="button"
                      class="sfm-tags-option {{if (includes tag this.pendingTags) "sfm-tags-option--selected"}}"
                      {{on "mousedown" (fn this.toggleTag tag)}}
                    >
                      <div class="sfm-tags-checkbox {{if (includes tag this.pendingTags) "sfm-tags-checkbox--checked"}}">
                        {{#if (includes tag this.pendingTags)}}
                          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                          </svg>
                        {{/if}}
                      </div>
                      {{tag}}
                    </button>
                  {{/each}}
                </div>
                <div class="sfm-tags-footer">
                  <button
                    type="button"
                    class="sfm-tags-apply"
                    {{on "mousedown" this.applyTags}}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    Apply Filter{{#if this.pendingTags.length}} ({{this.pendingTags.length}}){{/if}}
                  </button>
                </div>
              </div>
            {{/if}}
          </div>

          {{#if this.appliedTags.length}}
            <div class="sfm-tags">
              {{#each this.appliedTags as |tag|}}
                <span class="sfm-tag">
                  {{tag}}
                  <button
                    type="button"
                    class="sfm-tag-remove"
                    {{on "click" (fn this.removeTag tag)}}
                    aria-label="Remove {{tag}}"
                  >
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <line x1="18" y1="6" x2="6" y2="18"></line>
                      <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                  </button>
                </span>
              {{/each}}
            </div>
          {{/if}}
        </div>
      </div>

      <div class="sfm-footer">
        <button
          type="button"
          class="sfm-clear-all"
          {{on "click" this.clearAll}}
        >
          Clear All
        </button>
        <button
          type="button"
          class="sfm-search-btn"
          {{on "click" this.performSearch}}
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>

          Search
        </button>
      </div>
    </div>
  </div>
{{/if}}