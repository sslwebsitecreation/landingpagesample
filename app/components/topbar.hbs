<header class="topbar">
  <LinkTo @route="index" class="logo-container">
    <img src="assets/logo.jpg" alt="Riya Sri Silks" class="brand-logo-img" width="40" height="40" />
    <div class="logo-text">Riya Sri Silks</div>
  </LinkTo>

  <div class="desktop-nav">
    <form class="search-bar" {{on "submit" this.handleDesktopSearchSubmit}}>
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        class="search-input"
        placeholder="Search sarees..."
        value={{if this.isCollectionsRoute this.currentQ this.desktopQuery}}
        {{on "input" this.handleDesktopInputChange}}
        {{on "keyup" this.handleDesktopKeydown}}
        aria-label="Search"
      />
      {{#if this.isCollectionsRoute}}
        {{#if this.currentQ}}
          <button type="button" class="search-clear-btn" {{on "click" this.clearSearch}} aria-label="Clear search">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        {{/if}}
      {{/if}}
      <button type="button" class="filter-trigger" {{on "click" this.search.openFilterModal}} aria-label="Advanced filter">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="8" y1="12" x2="20" y2="12"></line>
          <line x1="12" y1="18" x2="20" y2="18"></line>
          <circle cx="6" cy="6" r="2" fill="currentColor"></circle>
          <circle cx="10" cy="12" r="2" fill="currentColor"></circle>
          <circle cx="14" cy="18" r="2" fill="currentColor"></circle>
        </svg>
      </button>
    </form>

    <nav aria-label="Main Navigation">
      <LinkTo @route="collections" class="nav-link">Collections</LinkTo>
      <LinkTo @route="about" class="nav-link">About</LinkTo>
      <LinkTo @route="cart" class="nav-link cart-link" aria-label="View Cart">
        <div class="cart-icon-wrapper">
          <svg class="cart-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          {{#if (gt this.cartCount 0)}}
            <span class="cart-badge">{{this.cartCount}}</span>
          {{/if}}
        </div>
      </LinkTo>
    </nav>
  </div>

  <button type="button" class="hamburger-btn" {{on "click" this.toggleMobileMenu}} aria-label="Menu">
    <span class="hamburger-line {{if this.showMobileMenu "hamburger-line--open"}}"></span>
    <span class="hamburger-line {{if this.showMobileMenu "hamburger-line--open"}}"></span>
    <span class="hamburger-line {{if this.showMobileMenu "hamburger-line--open"}}"></span>
  </button>
</header>

<div class="mobile-menu {{if this.showMobileMenu "mobile-menu--open"}}">
  <LinkTo @route="about" class="mobile-menu-link" {{on "click" this.toggleMobileMenu}}>About</LinkTo>
  <LinkTo @route="privacy" class="mobile-menu-link" {{on "click" this.toggleMobileMenu}}>Privacy Policy</LinkTo>
</div>

<nav class="mobile-bottom-nav" aria-label="Mobile Quick Access">
  <button type="button" class="mobile-nav-btn" {{on "click" (fn this.navigateTo "collections")}} aria-label="Collections">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="7" height="7"></rect>
      <rect x="14" y="3" width="7" height="7"></rect>
      <rect x="3" y="14" width="7" height="7"></rect>
      <rect x="14" y="14" width="7" height="7"></rect>
    </svg>
    <span>Collections</span>
  </button>
  <button type="button" class="mobile-nav-btn" {{on "click" this.search.openMobileSearch}} aria-label="Search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <span>Search</span>
  </button>
  <LinkTo @route="cart" class="mobile-nav-btn" aria-label="View Cart">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <span>Cart</span>
    {{#if (gt this.cartCount 0)}}
      <span class="mobile-cart-badge">{{this.cartCount}}</span>
    {{/if}}
  </LinkTo>
</nav>

<SearchFilterModal
  @visible={{this.search.showFilterModal}}
  @position="desktop"
  @onClose={{this.search.closeFilterModal}}
/>

<SearchFilterModal
  @visible={{this.search.showMobileSearch}}
  @position="mobile"
  @onClose={{this.search.closeMobileSearch}}
/>
