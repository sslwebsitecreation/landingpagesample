<section class="video-studio-section" {{scroll-reveal delay=100}}>
  <div class="studio-container">

    <div class="studio-intro">
      <span class="section-eyebrow">Behind the Loom</span>
      <h2 class="studio-title">Riya Sri Silks <span>Live Studio</span></h2>
      <p class="studio-subtitle">Curated Replays & Shoppable Moments</p>
      <p class="studio-description">Watch our latest showcases and discover the stories woven into every thread.</p>

      <div class="channel-action">
        <a href="https://youtube.com/@dummysri" target="_blank" rel="noopener noreferrer" class="youtube-channel-btn">
          <span class="yt-icon">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg>
          </span>
          <div class="btn-text">
            <small>FOLLOW US ON</small>
            <span>YouTube</span>
          </div>
        </a>
      </div>
    </div>

    {{#if this.currentStore.youtubeVideos.length}}
      <div class="video-selector-reel">
        {{#each this.currentStore.youtubeVideos as |video|}}
          <button type="button"
            class="video-card-mini {{if (equal video.id this.selectedVideo.id) 'is-active'}}"
            {{on "click" (fn this.selectVideo video)}}>
            <div class="mini-thumb">
              <img src={{video.thumb}} alt={{video.title}}>
              <div class="play-overlay"><span>▶</span></div>
            </div>
            <div class="mini-meta">
              <span class="v-name">{{video.title}}</span>
              <span class="v-date">{{video.date}}</span>
            </div>
          </button>
        {{/each}}
      </div>

      {{#if this.selectedVideo}}
        <div class="stage-3d-perspective {{if this.isVisible 'is-active'}}">
          <div class="stage-container">
            <button type="button" class="close-studio-btn" {{on "click" this.closeStudio}}>✕ Close</button>
            <div class="stage-layout">

              <div class="main-player">
                <div class="video-frame-3d">
                  <iframe src="https://www.youtube.com/embed/{{this.selectedVideo.youtubeId}}?autoplay=0&rel=0&showinfo=0"
                    frameborder="0" allowfullscreen title="riya sri silks video"></iframe>
                </div>
                <div class="player-info">
                  <div class="info-meta">
                    <span class="live-tag">Studio Exclusive</span>
                    <span class="player-date">• {{this.selectedVideo.date}}</span>
                  </div>
                  <h3>{{this.selectedVideo.title}}</h3>
                </div>
              </div>

              <div class="product-sidebar">
                <div class="sidebar-header">
                  <span class="eyebrow">The Collection</span>
                  <h4 class="title">Shop the <span>Look</span></h4>
                </div>

                <div class="sidebar-scroll">
                  {{#each this.selectedVideo.featuredSarees as |product|}}
                    <div class="saree-horizontal-card">
                      <div class="card-thumb">
                        <img src={{product.variants.[0].image}} alt={{product.name}}>
                        <button type="button" class="mini-add-btn" aria-label="Add to cart">+</button>
                      </div>

                      <div class="card-info">
                        <div class="info-top">
                          <h5 class="product-name">{{product.name}}</h5>
                        </div>
                        <div class="info-bottom">
                          <span class="product-price">₹{{product.price}}</span>
                          <button type="button" class="view-link">Details →</button>
                        </div>
                      </div>
                    </div>
                  {{/each}}
                </div>
              </div>

            </div>
          </div>
        </div>
      {{/if}}
    {{else}}
      <div class="empty-studio-placeholder">
        <span class="silk-emoji">✨</span>
        <h3>Studio Premiere Coming Soon</h3>
        <p>We're digitizing our latest collection showcases. Stay tuned for an immersive shopping experience.</p>
        <a href="https://youtube.com/@dummysri" class="big-youtube-push">Explore Our Channel</a>
      </div>
    {{/if}}
  </div>
</section>
