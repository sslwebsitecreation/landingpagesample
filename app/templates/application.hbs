{{#if this.loading.isAppLoading}}
  <LoadingIndicator />
{{else}}
  <ToastContainer />

  <Topbar/>

  <main id="main-content">
    {{outlet}}
  </main>

  <footer class="heritage-footer">
    <div class="footer-container">

      <div class="footer-top">
        <div class="footer-brand">
          <div class="brand-logo-row">
            <img src="/assets/logo.jpg" alt="Riyasri Silks" class="brand-logo" width="80" height="80" />
            <div class="brand-logo-name">Riyasri Silks</div>
          </div>
          <p class="brand-tagline">Where tradition meets timeless elegance</p>
          <p class="brand-manifesto">
            Curating India's finest handloom sarees for the modern woman who honors her roots.
          </p>

          <div class="footer-social-links">
            <a href="https://www.youtube.com/@riyasrisilk" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="social-link social-link--youtube">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
            <a href={{this.currentStore.whatsappLink}} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="social-link social-link--whatsapp">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </a>
            <a href="https://www.instagram.com/riyasri_silks/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="social-link social-link--instagram">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                <path d="M7.75 2C4.574 2 2 4.574 2 7.75v8.5C2 19.426 4.574 22 7.75 22h8.5C19.426 22 22 19.426 22 16.25v-8.5C22 4.574 19.426 2 16.25 2h-8.5zm0 1.8h8.5a3.95 3.95 0 013.95 3.95v8.5a3.95 3.95 0 01-3.95 3.95h-8.5a3.95 3.95 0 01-3.95-3.95v-8.5A3.95 3.95 0 017.75 3.8zm8.95 1.35a1.05 1.05 0 100 2.1 1.05 1.05 0 000-2.1zM12 7a5 5 0 100 10 5 5 0 000-10zm0 1.8A3.2 3.2 0 1112 15.2 3.2 3.2 0 0112 8.8z"/>
              </svg>
            </a>
          </div>
        </div>

        <div class="footer-columns">
          <div class="footer-column">
            <h4 class="footer-header">Explore</h4>
            <nav class="footer-links" aria-label="Main navigation">
              <LinkTo @route="index">Home</LinkTo>
              <LinkTo @route="collections">Collections</LinkTo>
              <LinkTo @route="about">About</LinkTo>
            </nav>
          </div>

          <div class="footer-column">
            <h4 class="footer-header">Shop By</h4>
            <nav class="footer-links" aria-label="Quick filters">
              <LinkTo @route="collections" @query={{hash tags="trending"}}>Trending</LinkTo>
              <LinkTo @route="collections" @query={{hash tags="new"}}>New Arrivals</LinkTo>
              <LinkTo @route="collections" @query={{hash tags="Handpicked"}}>Special Collection</LinkTo>
              <LinkTo @route="collections" @query={{hash tags="handloom"}}>Handloom</LinkTo>
            </nav>
          </div>

          <div class="footer-column">
            <h4 class="footer-header">Other Resources</h4>
            <nav class="footer-links" aria-label="Support links">
              <LinkTo @route="privacy">Privacy Policy</LinkTo>
            </nav>
          </div>
        </div>
      </div>

      <div class="footer-divider">
        <svg viewBox="0 0 40 6" width="40" height="6" fill="none">
          <circle cx="3" cy="3" r="2.5" fill="#ff6600" opacity="0.4"/>
          <circle cx="20" cy="3" r="1.5" fill="#ff6600" opacity="0.6"/>
          <circle cx="37" cy="3" r="2.5" fill="#ff6600" opacity="0.4"/>
        </svg>
      </div>

      <div class="footer-bottom">
        <p class="copyright">&copy; 2026 Riyasri Silks</p>
        <div class="footer-contact">
          <span>For more websites, contact:</span>
          <a href="mailto:sslwebsitecreation@gmail.com">sslwebsitecreation@gmail.com</a>
        </div>
      </div>

    </div>
  </footer>

{{/if}}
