<div class="cart-stage">
  <div class="cart-container">

    {{#if this.currentStore.cartItems.length}}
      {{!-- Summary Sidebar: Visible on Desktop --}}
      <aside class="summary-column">
        <div class="glass-summary-card">
          <h2 class="heritage-title">Order Inquiry</h2>
          <p class="summary-note">Review your selection before inquiring.</p>

          <div class="total-bracket">
            <span class="total-label">Subtotal Estimate</span>
            <div class="total-amount">₹{{this.subtotal}}</div>
          </div>

          <button type="button" class="whatsapp-trigger" {{on "click" this.sendToWhatsApp}}>
            <svg class="wa-icon" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.63 1.438h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Inquire via WhatsApp
          </button>
        </div>
      </aside>

      {{!-- Scrollable Item List --}}
      <main class="items-column">
        {{#each this.currentStore.cartItems key="id" as |item index|}}
          {{!-- template-lint-disable style-concatenation --}}
          {{!-- template-lint-disable no-inline-styles --}}
          <div class="cart-item-card" style="--delay: {{index}}">
            <LinkTo @route="product" @model={{item.id}} class="item-image-link">
              <div class="item-image-wrapper">
                <img src={{item.selectedVariant.image}} alt={{item.name}} class="product-img" loading="lazy" width="120" height="160">
              </div>
            </LinkTo>
            <div class="item-details">
              <LinkTo @route="product" @model={{item.id}} class="item-title-link">{{item.name}}</LinkTo>
              <span class="item-variant">{{item.selectedVariant.name}}</span>
              <div class="item-bottom-row">
                <div class="item-price-group">
                  <span class="item-price">₹{{item.price}}</span>
                  {{#if item.oldPrice}}
                    <span class="item-old-price">₹{{item.oldPrice}}</span>
                  {{/if}}
                </div>
                <div class="cart-qty-controls">
                  <button type="button" class="cart-qty-btn" {{on "click" (fn this.decreaseQty index)}} aria-label="Decrease">&minus;</button>
                  <span class="cart-qty-value">{{item.quantity}}</span>
                  <button type="button" class="cart-qty-btn" {{on "click" (fn this.increaseQty index)}} aria-label="Increase">+</button>
                </div>
              </div>
              <button type="button" class="remove-action" {{on "click" (fn this.removeItem index)}}>
                Remove
              </button>
            </div>
          </div>
        {{/each}}
      </main>

      {{!-- Mobile Sticky Bar (Amazon Style) --}}
      <div class="mobile-checkout-bar">
        <div class="sticky-total">
          <span class="sticky-label">Subtotal</span>
          <span class="sticky-amount">₹{{this.subtotal}}</span>
        </div>
        <button type="button" class="sticky-btn" {{on "click" this.sendToWhatsApp}}>
          INQUIRE NOW
        </button>
      </div>

    {{else}}
      {{!-- Empty State (Properly Centered) --}}
      <div class="empty-state-full">
        <div class="empty-visual-group">
          <div class="glow-sphere"></div>
          <img src="assets/empty-cart.png" alt="Empty Tray" class="empty-png-anim">
        </div>
        <h2 class="empty-heading">Your Tray is Empty</h2>
        <p class="empty-desc">Your curated collection of luxury sarees will appear here.</p>
        <LinkTo @route="collections" class="empty-cta">
          START EXPLORING
        </LinkTo>
      </div>
    {{/if}}

  </div>
</div>
