{{!-- Hero: Full-width banner with glow effect --}}
<HeroFlow/>

{{!-- Category Carousel: Browse by type --}}
<CategoryCarousel @onViewAll={{this.openCategoryModal}} />

{{!-- Video Showcase: Live studio content --}}
<VideoShowcase/>

{{!-- Featured Collection: Signature series showcase --}}
<FeaturedCollection/>

{{!-- Collection Tabs: Trending & specials grid --}}
<CollectionTabs/>

{{!-- Testimonials: Social proof --}}
<Testimonials/>

{{!-- Cinematic Promo: Scroll-driven finale CTA --}}
<CinematicPromo/>

{{!-- Category Modal (rendered at root level to avoid stacking context issues) --}}
{{#if this.isCategoryModalOpen}}
  {{!-- template-lint-disable no-invalid-interactive --}}
  <div class="category-modal-backdrop" {{on "click" this.closeCategoryModal}}>
    {{!-- template-lint-disable no-invalid-interactive --}}
    <div class="category-modal" {{on "click" this.stopPropagation}}>
      <div class="modal-header">
        <h3>All Collections</h3>
        <button type="button" class="modal-close-btn" {{on "click" this.closeCategoryModal}}>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="4" y1="4" x2="14" y2="14"></line>
            <line x1="14" y1="4" x2="4" y2="14"></line>
          </svg>
        </button>
      </div>
      <p class="modal-subtitle">Select a category to browse</p>
      <div class="modal-grid">
        {{#each this.currentStore.categories as |cat|}}
          <LinkTo
            @route="collections"
            @query={{hash category=cat.name page=1}}
            class="modal-card"
            {{on "click" this.closeCategoryModal}}
          >
            <div class="modal-card-img">
              <img src={{cat.image}} alt={{cat.name}} loading="lazy">
            </div>
            <div class="modal-card-info">
              <span class="modal-card-name">{{cat.name}}</span>
              <span class="modal-card-count">{{category-count cat this.currentStore.products}} pieces</span>
            </div>
          </LinkTo>
        {{/each}}
      </div>
    </div>
  </div>
{{/if}}
