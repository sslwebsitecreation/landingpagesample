{{#each this.toast.toastList key="id" as |toast|}}
  <div class="toast-root" role="status" aria-live="polite">
    <div class="toast-notification {{if (equal toast.type 'success') 'toast--success' 'toast--info'}}">
      <span class="toast-icon">
        {{#if (equal toast.type "success")}}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        {{else}}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        {{/if}}
      </span>
      <span class="toast-message">{{toast.message}}</span>
      <button type="button" class="toast-dismiss" {{on "click" this.dismiss}} aria-label="Dismiss">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
{{/each}}